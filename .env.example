# Environment Variables for E-commerce App

# Database
MONGODB_URI=mongodb://localhost:27017/ecommerce

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=your-admin-password

# AamarPay Payment Gateway
AAMARPAY_STORE_ID=your-store-id
AAMARPAY_SIGNATURE_KEY=your-signature-key
AAMARPAY_API_URL=https://sandbox.aamarpay.com/jsonpost.php
AAMARPAY_VERIFY_URL=https://sandbox.aamarpay.com/api/v1/trxcheck/request.php

# Application URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
